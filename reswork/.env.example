# Supabase (public anon key is safe to expose; service role is NOT)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only-never-expose

# Admin bootstrap: required to create the first workspace admin.
# Send as `admin_key` to POST /api/auth/register-admin. Never expose as NEXT_PUBLIC_*.
ADMIN_REGISTRATION_KEY=replace-me-with-a-long-random-secret

# Absolute server-side ceiling on workspace members. Must stay <= 10.
# The workspace row has its own soft `member_limit`, also capped at 10.
MAX_ALLOWED_MEMBERS=10

# Optional: default workspace name created at admin registration
DEFAULT_WORKSPACE_NAME=Research Workbench

# Cloud AI proxy: member BYOK keys are encrypted at rest (see lib/ai/keys.ts)
# or kept client-side only. Never store in a public row, never NEXT_PUBLIC_*.
CREDENTIALS_ENCRYPTION_KEY=replace-me-32-bytes-minimum

# Rate limits (Phase 3, Postgres-backed fixed windows; see migration 0010).
# Optional overrides — defaults apply when unset. Format: MAX requests per
# WINDOW_SECS seconds, per user (per IP for register-admin).
#RATE_LIMIT_REGISTER_ADMIN_MAX=5
#RATE_LIMIT_REGISTER_ADMIN_WINDOW_SECS=3600
#RATE_LIMIT_AI_PROXY_MAX=60
#RATE_LIMIT_AI_PROXY_WINDOW_SECS=60
#RATE_LIMIT_RAG_EMBED_MAX=120
#RATE_LIMIT_RAG_EMBED_WINDOW_SECS=60
#RATE_LIMIT_RAG_SEARCH_MAX=120
#RATE_LIMIT_RAG_SEARCH_WINDOW_SECS=60
#RATE_LIMIT_RESEARCH_TRAIL_MAX=200
#RATE_LIMIT_RESEARCH_TRAIL_WINDOW_SECS=60
